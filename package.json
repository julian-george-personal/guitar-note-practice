{
  "name": "guitar-note-practice",
  "private": true,
  "type": "module",
  "scripts": {
    "web:dev": "concurrently \"vite\" \"tsx test/server.ts\"",
    "ios:dev": "CAPACITOR_DEV=true npx cap sync ios && concurrently \"vite\" \"tsx test/server.ts\" \"npx cap run ios --no-sync --target-name 'iPhone 17'\"",
    "web:build": "vite build",
    "job:build": "esbuild job/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=job/dist/index.js",
    "ios:build": "CAPACITOR=true npm run web:build && npx cap sync ios",
    "lint": "eslint web/src"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@mlc-ai/web-llm": "^0.2.83",
    "pitchfinder": "^2.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tonal": "^6.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.4",
    "@types/aws-lambda": "^8.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0.0",
    "dotenv": "^16.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tsx": "^4.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.4"
  }
}
